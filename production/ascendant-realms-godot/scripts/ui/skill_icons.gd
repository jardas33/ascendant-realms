static var _cache := {}

## The star's icon as a texture, or null when it has none.
static func texture_for(skill_id: String, px: int = 128) -> Texture2D:
	var icon := String(ICON_FOR.get(skill_id, ""))
	return icon_texture(icon, px) if icon != "" else null

static func icon_texture(icon: String, px: int = 128) -> Texture2D:
	var key := "%s@%d" % [icon, px]
	if _cache.has(key):
		return _cache[key]
	var body := String(ICONS.get(icon, ""))
	if body == "":
		return null
	var svg := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"64\" viewBox=\"0 0 64 64\">" + DEFS \
		+ "<g stroke=\"#24160a\" stroke-width=\"2.2\" stroke-linejoin=\"round\" stroke-linecap=\"round\">" + body + "</g></svg>"
	var img := Image.new()
	if img.load_svg_from_string(svg, float(px) / 64.0) != OK:
		return null
	img.generate_mipmaps()
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
